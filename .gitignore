# env files (can opt-in for committing if needed)
.env*
!.env.example

# Generated client, browser reports, and scaffolder staging
/src/generated/prisma/
/playwright-report/
/test-results/
/.bootstrap/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.neon
