# Copy to .env (git-ignored). All values below are placeholders, never credentials.
# PostgreSQL: pooled URL for the application, direct URL for Prisma migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require"
# neon deploy / neon env pull writes this direct connection variable.
DATABASE_URL_UNPOOLED=""
# Optional conventional alias; used only if DATABASE_URL_UNPOOLED is absent.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Approved: Better Auth + GitHub-only OAuth + database sessions.
# npm run setup:init generates a secret in ignored .env, never in this file.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Reserved for later phases; no provider is configured or called in Phase 1.
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_WEBHOOK_SECRET=""
# AI_PROVIDER="deterministic"
# GEMINI_API_KEY=""
# GEMINI_MODEL=""
# AI_DAILY_LIMIT_PER_USER="30"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_TIMEZONE="Asia/Kuala_Lumpur"
APP_CURRENCY="MYR"
